    "buffer": "6.0.3",
    "mppx": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@x402/fetch": "2.28.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
