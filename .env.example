# Copy to .env (git-ignored) to change the scripts' defaults. No secret belongs here: the scripts
# keep keys in the Stellar CLI keystore (`stellar keys`).

# testnet | local (a quickstart network at protocol 29; see README, Quick start)
NETWORK=testnet

# usdc: Circle's testnet USDC (the default on testnet) | test: a self-issued FERMATATEST asset
# (the default on local). Leave unset to use the network's default.
# TOKEN=usdc

# Identities are $KEY_PREFIX-owner, -treasury, -vendor, -agent, -relayer, -verifier (and -issuer)
KEY_PREFIX=fermata

# The demo service: price in base units (7 decimals, so 100000 = 0.01), settlement window in
# seconds, escrow fee in basis points, service label, and the origin pinned for Milestone 1.
PRICE=100000
WINDOW=120
FEE_BPS=50
LABEL=quote
ORIGIN=https://vendor.fermata.test:8443

# Optional: sign verdicts with this key instead of the keystore's fermata-verifier identity
# (a Stellar secret seed S… or 64 hex characters). Prefer the keystore.
# FERMATA_VERIFIER_SECRET=
